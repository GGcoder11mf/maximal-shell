pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Palette (generated by matugen from the wallpaper), fonts and motion tokens.
// Every colour animates when the palette file changes.
Singleton {
    id: root

    readonly property string home: Quickshell.env("HOME")
    readonly property string rice: home + "/.config/hypr/rices/maximal"
    readonly property string scripts: rice + "/scripts/"

    // Palette crossfade: `prev` -> `c` driven by `t` (0..1). No Behaviors here:
    // Behavior inside a non-visual singleton crashes Qt.
    property var c: ({})
    property var prev: ({})
    property real t: 1
    // Crossfade in 12 eased steps (~0.9 s) instead of 60 fps: every step re-evaluates hundreds of
    // colour bindings across the shell, so fewer steps = no stutter on wallpaper/track changes.
    QtObject {
        id: blendAnim
        property int step: 0
        readonly property int steps: 12
        function restart() { step = 0; root.t = 0; blendTimer.restart(); }
    }
    Timer {
        id: blendTimer
        interval: 75; repeat: true
        onTriggered: {
            blendAnim.step++;
            const x = blendAnim.step / blendAnim.steps;
            root.t = x >= 1 ? 1 : x * x * (3 - 2 * x);        // smoothstep
            if (x >= 1) stop();
        }
    }

    // One shared clock for every spinning gradient (Spectrum), 20 fps. It only advances while
    // music is playing (Viz.active) and freezes in place on silence -> an idle desktop never
    // repaints for decoration; with music the whole UI spins up.
    property real spinT: 0
    Timer {
        interval: 50; repeat: true
        running: !root.calm && Viz.active
        onTriggered: root.spinT += 50
    }

    FileView {
        path: root.rice + "/generated/colors.json"
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            let next;
            try { next = JSON.parse(text()); } catch (e) { console.warn("Theme: bad colors.json", e); return; }
            if (Object.keys(root.c).length === 0) { root.prev = next; root.c = next; return; }
            const snap = {};
            for (const k of Object.keys(next)) if (k !== "wallpaper") snap[k] = root.pick(k, next[k]).toString();
            root.prev = snap;
            root.c = next;
            blendAnim.restart();
        }
    }

    function pick(k, d): color {
        const a = Qt.color(root.prev[k] ?? root.c[k] ?? d), b = Qt.color(root.c[k] ?? d);
        if (root.t >= 1) return b;
        return Qt.rgba(a.r + (b.r - a.r) * root.t, a.g + (b.g - a.g) * root.t, a.b + (b.b - a.b) * root.t, 1);
    }

    // ── Audio-reactive transform ───────────────────────────
    // While sound plays: hue sways (bounded) around the wallpaper hue, saturation + lightness swell with loudness/beats.
    // When silent and the phase is back home, colours are exactly the wallpaper palette.
    // uses Viz's *tone* set (~11 fps, quantised) — never the 30 fps set — because hundreds of bindings depend on these
    // PERF: a palette change re-evaluates every themed binding in the shell (~20 ms at once).
    // So each reactive colour has its own slot {h: hue offset, l: loudness} and a 30 fps timer
    // refreshes ONE slot per tick, round-robin (~2 ms each, every colour ~3x/s). The sway is slow,
    // so the stagger is invisible — and the UI thread never stalls.
    readonly property var _slotNames: ["sPrimary", "sPrimaryContainer", "sSecondary", "sSecondaryContainer", "sTertiary", "sTertiaryContainer", "sMagenta", "sCyan", "sBlue", "sGlass"]
    property var sPrimary: ({ h: 0, l: 0 })
    property var sPrimaryContainer: ({ h: 0, l: 0 })
    property var sSecondary: ({ h: 0, l: 0 })
    property var sSecondaryContainer: ({ h: 0, l: 0 })
    property var sTertiary: ({ h: 0, l: 0 })
    property var sTertiaryContainer: ({ h: 0, l: 0 })
    property var sMagenta: ({ h: 0, l: 0 })
    property var sCyan: ({ h: 0, l: 0 })
    property var sBlue: ({ h: 0, l: 0 })
    property var sGlass: ({ h: 0, l: 0 })
    property int _slot: 0
    property real _msSlot: 0      // profiling: decaying max ms per slot refresh
    Timer {
        interval: 33; repeat: true
        running: Viz.toneLevel > 0 || Viz.toneHue !== 0 || root._unsettled
        onTriggered: {
            const name = root._slotNames[root._slot];
            root._slot = (root._slot + 1) % root._slotNames.length;
            const cur = root[name], h = Viz.toneHue, l = Viz.toneLevel;
            if (Math.abs(cur.h - h) > 0.0005 || Math.abs(cur.l - l) > 0.005) {
                const t0 = Date.now();
                root[name] = { h, l };
                root._msSlot = Math.max(root._msSlot * 0.95, Date.now() - t0);
            }
        }
    }
    readonly property bool _unsettled: _slotNames.some(n => root[n].h !== 0 || root[n].l !== 0)

    function react(c: color, slot): color {
        if (!slot || (slot.h === 0 && slot.l === 0)) return c;
        const h0 = c.hslHue < 0 ? 0 : c.hslHue;
        let h = h0 + slot.h;                    // bounded sway around the wallpaper hue
        h -= Math.floor(h);
        const sat = Math.min(1, c.hslSaturation + slot.l * 0.18);
        return Qt.hsla(h, sat, c.hslLightness, c.a);
    }

    // ── Palette ────────────────────────────────────────────
    property color basePrimary: pick("primary", "#a7c8ff")
    readonly property color primary: react(basePrimary, sPrimary)
    property color onPrimary: pick("onPrimary", "#003061")
    property color basePrimaryContainer: pick("primaryContainer", "#004689")
    readonly property color primaryContainer: react(basePrimaryContainer, sPrimaryContainer)
    property color onPrimaryContainer: pick("onPrimaryContainer", "#d5e3ff")
    property color baseSecondary: pick("secondary", "#bec5eb")
    readonly property color secondary: react(baseSecondary, sSecondary)
    property color baseSecondaryContainer: pick("secondaryContainer", "#3e4565")
    readonly property color secondaryContainer: react(baseSecondaryContainer, sSecondaryContainer)
    property color onSecondaryContainer: pick("onSecondaryContainer", "#dde1ff")
    property color baseTertiary: pick("tertiary", "#c7c0f9")
    readonly property color tertiary: react(baseTertiary, sTertiary)
    property color baseTertiaryContainer: pick("tertiaryContainer", "#463f70")
    readonly property color tertiaryContainer: react(baseTertiaryContainer, sTertiaryContainer)
    property color onTertiaryContainer: pick("onTertiaryContainer", "#e4dfff")
    property color error: pick("error", "#ffb4ab")
    property color errorContainer: pick("errorContainer", "#93000a")
    property color surface: pick("surface", "#111318")
    property color surfaceLow: pick("surfaceLow", "#191c20")
    property color surfaceContainer: pick("surfaceContainer", "#1d2024")
    property color surfaceHigh: pick("surfaceHigh", "#282a2f")
    property color surfaceHighest: pick("surfaceHighest", "#33353a")
    property color text: pick("onSurface", "#e2e2e9")
    property color subtext: pick("onSurfaceVariant", "#c4c6d0")
    property color outline: pick("outline", "#8e9099")
    property color outlineVariant: pick("outlineVariant", "#44474e")
    property color red: pick("red", "#ffb2be")
    property color green: pick("green", "#7fdba0")
    property color yellow: pick("yellow", "#f0c86a")
    property color baseBlue: pick("blue", "#a9c7ff")
    readonly property color blue: react(baseBlue, sBlue)
    property color baseMagenta: pick("magenta", "#f0b0ff")
    readonly property color magenta: react(baseMagenta, sMagenta)
    property color baseCyan: pick("cyan", "#7fdbd2")
    readonly property color cyan: react(baseCyan, sCyan)
    property color orange: pick("orange", "#ffb68a")


    // Derived
    // glass picks up the music: tinted toward the (moving) accent by loudness, flashes on beats
    readonly property real _tint: Math.min(0.25, sGlass.l * 0.22)
    readonly property color glass: Qt.alpha(mix(surface, primaryContainer, _tint), 0.74)
    readonly property color glassHi: Qt.alpha(mix(surfaceHigh, primaryContainer, _tint), 0.78)
    readonly property color chip: Qt.alpha(surfaceHighest, 0.62)
    readonly property var spectrum: [primary, tertiary, magenta, cyan, primary]

    // ── Type ───────────────────────────────────────────────
    readonly property string font: "Rubik"
    readonly property string mono: "JetBrainsMono Nerd Font"
    readonly property string icons: "Material Symbols Rounded"

    // ── Shape ──────────────────────────────────────────────
    readonly property int radius: 18
    readonly property int radiusSm: 12
    readonly property int radiusLg: 28
    readonly property int gap: 10

    // ── Motion (zeroed in game mode) ───────────────────────
    readonly property bool calm: Shell.gameMode
    readonly property int fast: calm ? 0 : 160
    readonly property int normal: calm ? 0 : 320
    readonly property int slow: calm ? 0 : 600
    readonly property int xslow: calm ? 0 : 1100
    readonly property var springy: Easing.OutBack
    readonly property var smooth: Easing.OutCubic
    readonly property var expo: Easing.OutExpo

    function mix(a, b, t) { return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.a + (b.a - a.a) * t); }
}
